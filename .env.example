# Reference only: GigHunt does not load this file automatically.
# Supply non-secret settings through your shell or OS service environment.
GIGHUNT_URL=http://127.0.0.1:4317
GIGHUNT_FAKE_PROVIDERS=false
OPENAI_MODEL=gpt-5-mini
# Optional: GIGHUNT_CONFIG_DIR, GIGHUNT_DB
# Secrets belong in the OS credential store via `gighunt secret set NAME`.
# Required for real discovery/drafting: OPENAI_API_KEY, BRAVE_API_KEY
# Optional enrichment: HUNTER_API_KEY
# Required for persistent Gmail: GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET,
# GMAIL_REFRESH_TOKEN (gmail.send scope, offline access)
# Optional service token overrides: GIGHUNT_TOKEN, GIGHUNT_MCP_TOKEN
